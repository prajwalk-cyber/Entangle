rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection: Public keys for encryption
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.data.username is string
                            && request.resource.data.username.size() > 0
                            && request.resource.data.username.size() <= 50
                            && request.resource.data.publicKeyClassical is string
                            && request.resource.data.pqPublicHint is string;
    }

    // Chat sessions collection
    match /sessions/{sessionId} {
      allow read, create: if request.auth != null
                          && request.auth.uid != null;
    }

    // Encrypted messages (end-to-end encrypted)
    match /messages/{sessionId}/chat/{messageId} {
      allow read: if request.auth != null
                  && request.auth.uid != null;
      allow create: if request.auth != null
                    && request.auth.uid != null
                    && request.resource.data.ciphertext is string
                    && request.resource.data.nonce is string
                    && request.resource.data.senderId is string
                    && request.resource.data.senderId == request.auth.uid;
    }

  }
}
